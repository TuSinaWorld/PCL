<local:MyPageRight xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL" x:Class="PageSetupLink" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="VLan 联机服务器">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabServer" Text="尚未设置服务器；使用朋友的邀请码可直接加入。" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <local:MyButton x:Name="BtnConfigure" Text="设置服务器" HorizontalAlignment="Left" Padding="15,8"/>
                    <local:MyButton x:Name="BtnTest" Text="测试服务器连接" HorizontalAlignment="Left" Padding="15,8" Margin="0,10,0,0"/>
                    <TextBlock Text="服务器密码按当前 Windows 用户加密保存。邀请码包含连接凭据，请仅分享给可信好友。" TextWrapping="Wrap" Margin="0,15,0,0"/>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="房间与连接选项">
                <StackPanel Margin="25,40,25,20">
                    <CheckBox x:Name="CheckCompatibility" Content="使用 TCP Relay 兼容模式（下次创建房间生效）" Margin="0,0,0,15"/>
                    <CheckBox x:Name="CheckNoPassword" Content="创建不设房间密码的房间" Margin="0,0,0,10"/>
                    <TextBlock Text="默认自动设置随机房间密码并放入邀请码，无需手动输入。不设房间密码时，同一服务器的其他已鉴权用户也可能加入。" TextWrapping="Wrap"/>
                    <TextBlock Text="联机使用 Wintun 虚拟网卡，需要管理员授权；只提升联机辅助进程，游戏与启动器保持普通权限。" TextWrapping="Wrap" Margin="0,15,0,0"/>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
