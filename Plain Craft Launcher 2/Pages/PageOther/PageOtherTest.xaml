<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard Title="自定义下载" Margin="0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="将文件加入 PCL 下载任务，在任务管理中查看进度或取消。" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,15" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="下载地址" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <local:MyTextBox x:Name="TextDownloadUrl" Grid.Column="1" Grid.ColumnSpan="2" Height="29" HintText="https://example.com/file.zip" />
                        <TextBlock Text="文件名" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <local:MyTextBox x:Name="TextDownloadName" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="29" HintText="保存的文件名称" />
                        <TextBlock Text="保存位置" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <local:MyTextBox x:Name="TextDownloadFolder" Grid.Row="4" Grid.Column="1" Height="29" HintText="完整的文件夹路径" />
                        <local:MyButton x:Name="BtnDownloadSelect" Grid.Row="4" Grid.Column="2" Text="选择" Margin="12,0,0,0" Width="65" Height="29" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <local:MyButton x:Name="BtnDownloadStart" Text="开始下载" ColorType="Highlight" Width="115" Height="32" Margin="0,0,12,0" IsEnabled="False" />
                        <local:MyButton x:Name="BtnDownloadOpen" Text="打开文件夹" Width="115" Height="32" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="实用工具" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <WrapPanel>
                        <local:MyButton x:Name="BtnJrrp" Text="今日人品" Width="115" Height="32" Margin="0,0,12,12" />
                        <local:MyButton x:Name="BtnClear" Text="清理 PCL 缓存" Width="140" Height="32" Margin="0,0,12,12" />
                        <local:MyButton x:Name="BtnMemory" Text="整理系统内存" Width="140" Height="32" Margin="0,0,12,12" />
                    </WrapPanel>
                    <TextBlock Text="缓存清理会先列出目标并请求确认；内存整理需要管理员权限，Windows 可能显示授权窗口。" TextWrapping="Wrap" Opacity="0.65" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardCave" Title="回声洞" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabCave" Text="我们需要再深入些！" TextWrapping="Wrap" FontSize="16" MinHeight="45" VerticalAlignment="Center" Cursor="Hand" ToolTip="点击换一条留言" />
                    <local:MyButton x:Name="BtnCave" Text="再来一条" Width="115" Height="30" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="你知道吗" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock x:Name="LabHint" TextWrapping="Wrap" MinHeight="38" />
                    <local:MyButton x:Name="BtnHint" Text="换个提示" Width="115" Height="30" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
